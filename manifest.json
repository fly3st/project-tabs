{
  "manifest_version": 3,
  "name": "Project Tabs",
  "version": "1.2.1",
  "description": "Manage Chrome tab groups as projects: search, focus, close and reopen them, and see tabs from your other devices.",
  "permissions": ["tabs", "tabGroups", "storage", "sidePanel", "favicon", "sessions"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Project Tabs",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open the Project Tabs side panel"
    }
  }
}
